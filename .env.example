# Kopiér denne fil til ".env" og udfyld de to felter. ".env" er ignoreret af Git
# og må aldrig committes eller deles. Genstart appen efter ændringer.

# Din personlige API-nøgle fra Roboref. Behandl den som en adgangskode.
ROBOREF_API_KEY=

# Adressen til DIN organisations Roboref-API, inklusive /api/v2 og uden afsluttende
# skråstreg. Den får du af din Roboref-administrator (formen er https://<din-adresse>/api/v2).
ROBOREF_BASE_URL=

# Valgfrit: det navn, som dine handlinger registreres under i loggen (standard: Lokal bruger).
# Der er intet login; navnet er en mærkat og ikke bevis for, hvem der handlede.
ROBOREF_USER_NAME=

# Valgfrit: true betyder, at den, der har uploadet en version, ikke selv må godkende den
# (firøjneprincippet). Kræver login, så der er flere forskellige brugere (standard: false).
ROBOREF_REQUIRE_FOUR_EYES=

# Valgfrit: port på din egen computer (standard: 5188). Heltal mellem 1024 og 65535.
ROBOREF_PORT=

# Valgfrit: mappe til databasen og dens sikkerhedskopier (standard: data/ i projektmappen).
ROBOREF_DATA_DIR=

# ---- Login med Entra ID (kun til drift på en server; se docs/login-entra-id.md) ----

# local = intet login, kun din egen computer (standard). oidc = login med Entra ID.
ROBOREF_AUTH_MODE=

# Din Entra-adresse: https://login.microsoftonline.com/<mappe-id>/v2.0
ROBOREF_OIDC_ISSUER=

# Program-id (klient) fra appregistreringen i Entra.
ROBOREF_OIDC_CLIENT_ID=

# Klienthemmeligheden fra Entra. Behandl den som en adgangskode.
ROBOREF_OIDC_CLIENT_SECRET=

# Appens offentlige HTTPS-adresse uden sti, fx https://beslutningslog.kommune.dk
ROBOREF_PUBLIC_URL=

# true (standard) kræver, at login er sket med to-faktor.
ROBOREF_REQUIRE_MFA=

# Hvor mange timer en login-session gælder (1-72, standard 8).
ROBOREF_SESSION_HOURS=

# Adresse serveren lytter på (standard 127.0.0.1). Ændres kun bag en HTTPS-proxy.
ROBOREF_HOST=
